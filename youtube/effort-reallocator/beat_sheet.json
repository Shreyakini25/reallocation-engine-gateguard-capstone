                "slotsPct": 50
              },
              {
                "name": "no supported board",
                "evidencePct": 96,
                "slotsPct": 50
              }
            ],
            "ratioLabel": "disparate impact ratio 0.0265"
          },
          "rendered": {
            "out": "media/B12.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B12.mp3",
      "actual_duration_s": 12.86,
      "build": {
        "status": "VIDEO",
        "src": "media/B12.mp4",
