    {
      "beat_id": "B12",
      "act": "The surprising failure",
      "narration_text": "The bias in this tool is not in the model. It is in which companies I built an adapter for. Nothing in the math is wrong, and the answer is still shaped by a plumbing decision I made months ago.",
      "new_visual_element": "ATS coverage ratio bars",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "drawon",
        "remotion": {
          "pattern": "RatioBarsCard",
          "props": {
            "groups": [
