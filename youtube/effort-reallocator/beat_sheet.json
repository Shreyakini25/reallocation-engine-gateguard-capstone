    {
      "beat_id": "B12B",
      "act": "The surprising failure",
      "narration_text": "There were two ways to define fair here, and they cannot both hold. Parity says every company gets slots in proportion to how many are eligible. Calibration says slots follow the evidence. Choosing parity would mean spending real weeks applying into postings nobody can verify. Choosing calibration — what this tool does — means two hundred thirty-eight companies with deep sponsorship records, and three hundred twenty-two more with thin ones, get nothing either way. There is no allocation that satisfies both definitions at once.",
      "new_visual_element": "parity vs calibration tradeoff",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "drawon",
        "remotion": {
          "pattern": "TradeoffCard",
          "props": {
            "leftName": "PARITY",
            "leftCost": "ratio 0.0265 — slots into unverifiable postings",
            "rightName": "CALIBRATION",
            "rightCost": "238 deep-record + 322 thin-record firms get nothing",
            "footer": "No allocation satisfies both at once."
          },
          "rendered": {
            "out": "media/B12B.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B12B.mp3",
      "actual_duration_s": 33.81,
      "build": {
        "status": "VIDEO",
        "src": "media/B12B.mp4",
        "filled_by": "media",
        "at": "2026-07-27T20:42:51"
      }
    },
