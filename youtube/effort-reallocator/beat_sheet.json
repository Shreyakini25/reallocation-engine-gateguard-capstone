    {
      "beat_id": "B08B",
      "act": "The move and its uncertainty",
      "narration_text": "The tool measures its own overconfidence, too. If you let it re-optimize inside every resample, it reports a gain of plus zero point one two eight. Held fixed to the one allocation it actually recommends, the honest number is plus zero point one two. The gap — about six percent — is the optimizer fitting noise nobody can see. Reporting only the first number would have been the easier, more flattering lie.",
      "new_visual_element": "optimizer's curse: fixed vs re-optimized gain",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "drawon",
        "remotion": {
          "pattern": "TwoNumbersCompareCard",
          "props": {
            "eyebrow": "THE OPTIMIZER'S CURSE",
            "leftLabel": "held fixed to the recommended allocation",
            "leftValue": 0.11989,
            "rightLabel": "re-optimized inside every resample",
            "rightValue": 0.12766,
            "gapLabel": "+0.00777 · 6.1% is the optimizer fitting noise"
          },
          "rendered": {
            "out": "media/B08B.mp4",
            "at": ""
